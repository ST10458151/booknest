@model Book
@{ ViewData["Title"] = "Remove a Book"; }
<div class="form-shell delete-page"><div class="form-intro"><p class="eyebrow">TIDYING YOUR SHELF</p><h1>One less <em>chapter?</em></h1><p>Are you sure you want to remove this book from your library?</p></div>
<div class="book-form"><h2>@Model.Title</h2><p>by @Model.Author</p><p class="delete-warning">This removes the book and your saved reading progress. This action cannot be undone.</p>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post"><div class="form-actions"><a class="button button-outline" asp-action="Index">Keep this book</a><button class="button button-danger" type="submit">Yes, remove book</button></div></form></div></div>
